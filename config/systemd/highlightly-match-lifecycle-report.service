[Unit]
Description=ASP Insights Highlightly Phase 8E.1 operational report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/ubuntu/asp-insights-c73dbc6b
EnvironmentFile=/etc/asp-scraper-api.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/flock --exclusive --wait 14400 --conflict-exit-code 75 /run/lock/asp-highlightly-future.lock /home/ubuntu/asp-scraper-api/.venv/bin/python -m scripts.report_highlightly_phase8e_operational --hours 24 --recover-provider --require-provider-disabled
TimeoutStartSec=18000
Nice=10
