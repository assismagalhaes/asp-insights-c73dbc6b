{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "asp-insights",
  "main": "./src/server.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "env": {
    "staging": {
      "name": "asp-insights-staging",
      "workers_dev": true,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "staging.asp-insights.com.br",
          "custom_domain": true,
        },
      ],
    },
  },
}
