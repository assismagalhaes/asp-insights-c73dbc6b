# Public Supabase configuration. VITE_* values are shipped to the browser.
SUPABASE_PROJECT_ID=replace-with-project-ref
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
VITE_SUPABASE_PROJECT_ID=replace-with-project-ref
VITE_SUPABASE_URL=https://replace-with-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Server-only application secrets. Configure these as Cloudflare Worker secrets.
SUPABASE_SERVICE_ROLE_KEY=replace-at-deploy
SCRAPER_API_URL=https://api.example.com
SCRAPER_API_KEY=replace-at-deploy
HIGHLIGHTLY_INGEST_BRIDGE_SECRET=replace-at-deploy
FIRECRAWL_API_KEY=replace-at-deploy
GOOGLE_AI_API_KEY=replace-at-deploy

# Temporary Lovable connector secrets. Remove after the Telegram migration.
LOVABLE_API_KEY=replace-at-deploy
TELEGRAM_API_KEY=replace-at-deploy
